# Applications (A130): their files take MPLAB Harmony's names (SYS_Initialize(), DOOR_Tasks(),
# DOOR_DATA, doorData), so the naming rules are the kernel's and the drivers' alone. Every other
# check is the root's.
InheritParentConfig: true
Checks: '-readability-identifier-naming'
