{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-gcc",
      "displayName": "native, GCC, base profile, checked",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-gcc",
      "toolchainFile": "${sourceDir}/cmake/toolchains/native-gcc.cmake",
      "cacheVariables": {
        "EMB_BOARD": "native",
        "EMB_PROFILE": "base"
      }
    },
    {
      "name": "native-clang",
      "displayName": "native, Clang, base profile, checked",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-clang",
      "toolchainFile": "${sourceDir}/cmake/toolchains/native-clang.cmake",
      "cacheVariables": {
        "EMB_BOARD": "native",
        "EMB_PROFILE": "base"
      }
    },
    {
      "name": "native-periodic",
      "displayName": "native, GCC, base profile, checked, periodic clock",
      "inherits": "native-gcc",
      "binaryDir": "${sourceDir}/build/native-periodic",
      "cacheVariables": {
        "EMB_CONF": "configs/native-periodic.conf"
      }
    },
    {
      "name": "native-timeslice",
      "displayName": "native, GCC, base profile, checked, round-robin time slicing",
      "inherits": "native-gcc",
      "binaryDir": "${sourceDir}/build/native-timeslice",
      "cacheVariables": {
        "EMB_CONF": "configs/native-timeslice.conf"
      }
    },
    {
      "name": "native-timeslice-tickless",
      "displayName": "native, GCC, base profile, checked, time slicing with the tickless clock",
      "inherits": "native-gcc",
      "binaryDir": "${sourceDir}/build/native-timeslice-tickless",
      "cacheVariables": {
        "EMB_CONF": "configs/native-timeslice-tickless.conf"
      }
    },
    {
      "name": "native-release",
      "displayName": "native, GCC, base profile, release build kind",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/native-gcc.cmake",
      "cacheVariables": {
        "EMB_BOARD": "native",
        "EMB_PROFILE": "base",
        "EMB_CONF": "configs/release.conf"
      }
    },
    {
      "name": "native-tiny",
      "displayName": "native, GCC, tiny profile (table scheduler, 32-bit time)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-tiny",
      "toolchainFile": "${sourceDir}/cmake/toolchains/native-gcc.cmake",
      "cacheVariables": {
        "EMB_BOARD": "native",
        "EMB_PROFILE": "tiny"
      }
    },
    {
      "name": "native-asan",
      "displayName": "native, Clang, AddressSanitizer + UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-asan",
      "toolchainFile": "${sourceDir}/cmake/toolchains/native-sanitizers.cmake",
      "cacheVariables": {
        "EMB_BOARD": "native",
        "EMB_PROFILE": "base"
      }
    },
    {
      "name": "native-tsan",
      "displayName": "native, Clang, ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-tsan",
      "toolchainFile": "${sourceDir}/cmake/toolchains/native-tsan.cmake",
      "cacheVariables": {
        "EMB_BOARD": "native",
        "EMB_PROFILE": "base"
      }
    },
    {
      "name": "native-coverage",
      "displayName": "native, GCC, gcov coverage, checked",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-coverage",
      "toolchainFile": "${sourceDir}/cmake/toolchains/native-coverage.cmake",
