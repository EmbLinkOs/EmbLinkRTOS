# Editor setup: clangd reads the compilation database of the native checked build,
# which carries the include paths and the generated <emb/config.h> and <emb/storage.h>.
# Create it once with `cmake --preset native-gcc`; headers borrow a nearby source's flags.
CompileFlags:
  CompilationDatabase: build/native-gcc
