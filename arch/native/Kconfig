# Native port options (SPEC-013).

if EMB_ARCH_NATIVE

menu "Native port"

config EMB_NATIVE_INVARIANTS
	bool "Run the kernel invariant checker after every operation"
	depends on EMB_CHECKED
	default EMB_CHECKED
	help
	  SPEC-013 §8, A93: embk_invariants_check() at every gate crossing (each unlock
	  of the outermost critical section): the scheduler's ready structure against the
	  threads' states, and the table scheduler's count of raised threads. The primary
	  oracle in asynchronous interrupt mode.

config EMB_NATIVE_MAX_IRQS
	int "Number of simulated interrupt sources"
	default 32
	range 1 1024

config EMB_NATIVE_HOST_STACK
	int "Host stack size per simulated thread, bytes"
	default 262144
	range 65536 16777216
	help
	  SPEC-013 §4: host stacks are unrelated to the configured thread stack sizes.

endmenu

endif
