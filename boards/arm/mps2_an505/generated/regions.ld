 * tables are bracketed by name (SPEC-001 §6.4, HW-006). */
ENTRY(embn_cm_reset)

MEMORY
{
  FLASH (rx)  : ORIGIN = 0x10000000, LENGTH = 4M
  RAM   (rwx) : ORIGIN = 0x38000000, LENGTH = 4M
}

