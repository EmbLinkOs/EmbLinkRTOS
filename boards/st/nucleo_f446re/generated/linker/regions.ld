/**
 * @file    regions.ld
 * @brief   Linker script for nucleo_f446re (STM32F446RE): the app partition in FLASH, RAM from
 *          sram1 + sram2. The kernel's registration tables are bracketed by name (SPEC-001 §6.4,
 *          HW-006).
 *
 * @details
 * Generated by emb-hwgen 0.1.0, schema v0. Do not edit: change the
 * description and run hw/gen/emb-hwgen.py generate --board boards/st/nucleo_f446re (HW-003).
 * Inputs (SHA-256):
 *   arch/cortex_m/arch.yaml
 *     c5c8e451c09717dee1713d07f8311b6d507e3b4c66c42d93e0ce11da6ec76d6d
 *   boards/st/nucleo_f446re/board.yaml
 *     d756f3a7f19dc7da82ee3afc168dc54946312c5a9990720953c0fedcdece54ea
 *   drivers/bindings.yaml
 *     d3c336ac05548e0addd1faac18f3dff70576d8069f11d89e6a761cf5c6132b49
 *   soc/st/stm32f4/stm32f4.yaml
 *     796886c294250aa81151a620d80d0e43b5ee8e1bf53a07d1d7e2c62e95214dbd
 *   soc/st/stm32f4/stm32f446.yaml
 *     f886e45e3f9c4f81d64fd1021b5efc3d2d8d2f0d07fd4f985c101bcc8d26bd5a
 *   soc/st/stm32f4/stm32f446re.yaml
 *     b9a88d0a94aa17ee83317a3a56f7c194ec1b3107dfb3e82e453122dc1c48f6d4
 */
ENTRY(embn_cm_reset)

MEMORY
{
  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 384K
  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 128K
}

SECTIONS
{
  /* the vector table, then any block the SoC's boot ROM looks for near the image's start
     (the RP2350's IMAGE_DEF, A79) */
  .vectors : { KEEP(*(.vectors)) KEEP(*(.emb_boot_block)) } > FLASH

  .text : {
    *(.text .text.*)
    *(.rodata .rodata.*)
    . = ALIGN(16); /* the table entries' own alignment (sizeof(void *) * 4) */
    __start_emb_init_table = .;
    KEEP(*(emb_init_table))
    __stop_emb_init_table = .;
    . = ALIGN(16);
    __start_emb_test_table = .;
    KEEP(*(emb_test_table))
    __stop_emb_test_table = .;
    . = ALIGN(8);
  } > FLASH

  .ARM.exidx : { *(.ARM.exidx* .gnu.linkonce.armexidx.*) } > FLASH

  /* the interrupt stack, MSP (CONFIG_EMB_ISR_STACK_SIZE, A90): first in RAM, so that an
     overflow runs off the bottom of RAM into a bus fault, not into .data */
  .emb_isr_stack (NOLOAD) : ALIGN(8) {
    __emb_isr_stack_start = .;
    KEEP(*(.emb_isr_stack))
    __emb_isr_stack_end = .;
  } > RAM

  __data_load = LOADADDR(.data);
  .data : ALIGN(8) {
    __data_start = .;
    /* code that runs from RAM, copied with the data: the RP2350's flash routines, which run
       while XIP is off (SPEC-017 §9) */
    *(.ramfunc .ramfunc.*)
    *(.data .data.*)
    . = ALIGN(8);
    __data_end = .;
  } > RAM AT > FLASH

  .bss (NOLOAD) : ALIGN(8) {
    __bss_start = .;
    *(.bss .bss.* COMMON)
    . = ALIGN(8);
    __bss_end = .;
  } > RAM

  end = .;
  /* the crash record's memory (SPEC-015 §4, A73): above the stack and outside every loaded
     segment, so neither startup nor a loader's reset clears it */
  __emb_retained_end = ORIGIN(RAM) + LENGTH(RAM);
  __emb_retained_start = __emb_retained_end - 192;
  /* below it, 32 bytes the test framework keeps across the resets of its fault checks (A89) */
  __emb_test_retained_end = __emb_retained_start;
  __emb_test_retained_start = __emb_test_retained_end - 32;
  __stack_top = __emb_isr_stack_end;
  ASSERT(end <= __emb_test_retained_start, "RAM overflow: .data and .bss reach the retained memory")

  /* the log's call sites (A127): kept in the ELF for tools/logdec and out of the image. At
     address 0, from which a record's identifier is its metadata's offset plus 8; the first 8
     bytes stay empty, so no metadata is at address 0, the null pointer. Last, since setting
     its address moves the location counter. */
  emb_log 0 (INFO) : {
    __start_emb_log = .;
    . += 8;
    KEEP(*(emb_log))
    __stop_emb_log = .;
  }
}
