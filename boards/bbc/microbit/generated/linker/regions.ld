/**
 * @file    regions.ld
 * @brief   Linker script for microbit (nRF51822): the app partition in FLASH, RAM from sram. The
 *          kernel's registration tables are bracketed by name (SPEC-001 §6.4, HW-006).
 *
 * @details
 * Generated by emb-hwgen 0.1.0, schema v0. Do not edit: change the
 * description and run hw/gen/emb-hwgen.py generate --board boards/bbc/microbit (HW-003).
 * Inputs (SHA-256):
 *   arch/cortex_m/arch.yaml
 *     c5c8e451c09717dee1713d07f8311b6d507e3b4c66c42d93e0ce11da6ec76d6d
 *   boards/bbc/microbit/board.yaml
 *     3f8eded55e3160945a61c11f0d6e9412eb2088a88aa17979cd76b19c3199c038
 *   soc/nordic/nrf51/nrf51.yaml
 *     26f9d35bbc80483ff5cf73a4644dc15b485d6c8c1457119fe7658445f211a585
 *   soc/nordic/nrf51/nrf51822.yaml
 *     6b721af4e836655bd301c97156bc9e11b72ca7b5c967cc99228c4d3daa79b23c
 */
ENTRY(embn_cm_reset)

MEMORY
{
  FLASH (rx)  : ORIGIN = 0x00000000, LENGTH = 256K
  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
}

SECTIONS
{
  /* the vector table, then any block the SoC's boot ROM looks for near the image's start
     (the RP2350's IMAGE_DEF, A79) */
  .vectors : { KEEP(*(.vectors)) KEEP(*(.emb_boot_block)) } > FLASH

  .text : {
    *(.text .text.*)
    *(.rodata .rodata.*)
    . = ALIGN(16); /* the table entries' own alignment (sizeof(void *) * 4) */
    __start_emb_init_table = .;
    KEEP(*(emb_init_table))
    __stop_emb_init_table = .;
    . = ALIGN(16);
    __start_emb_test_table = .;
    KEEP(*(emb_test_table))
    __stop_emb_test_table = .;
    . = ALIGN(8);
  } > FLASH

  .ARM.exidx : { *(.ARM.exidx* .gnu.linkonce.armexidx.*) } > FLASH

  /* the interrupt stack, MSP (CONFIG_EMB_ISR_STACK_SIZE, A90): first in RAM, so that an
     overflow runs off the bottom of RAM into a bus fault, not into .data */
  .emb_isr_stack (NOLOAD) : ALIGN(8) {
    __emb_isr_stack_start = .;
    KEEP(*(.emb_isr_stack))
    __emb_isr_stack_end = .;
  } > RAM

  __data_load = LOADADDR(.data);
  .data : ALIGN(8) {
    __data_start = .;
    /* code that runs from RAM, copied with the data: the RP2350's flash routines, which run
       while XIP is off (SPEC-017 §9) */
    *(.ramfunc .ramfunc.*)
    *(.data .data.*)
    . = ALIGN(8);
    __data_end = .;
  } > RAM AT > FLASH

  .bss (NOLOAD) : ALIGN(8) {
    __bss_start = .;
    *(.bss .bss.* COMMON)
    . = ALIGN(8);
    __bss_end = .;
  } > RAM

  end = .;
  /* the crash record's memory (SPEC-015 §4, A73): above the stack and outside every loaded
     segment, so neither startup nor a loader's reset clears it */
  __emb_retained_end = ORIGIN(RAM) + LENGTH(RAM);
  __emb_retained_start = __emb_retained_end - 192;
  /* below it, 32 bytes the test framework keeps across the resets of its fault checks (A89) */
  __emb_test_retained_end = __emb_retained_start;
  __emb_test_retained_start = __emb_test_retained_end - 32;
  __stack_top = __emb_isr_stack_end;
  ASSERT(end <= __emb_test_retained_start, "RAM overflow: .data and .bss reach the retained memory")
}
